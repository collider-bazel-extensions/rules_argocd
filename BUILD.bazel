load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
    "WORKSPACE",
    "defs.bzl",
    "extensions.bzl",
    "repositories.bzl",
])

# The pinned argocd CLI (#5): `bazel run @rules_argocd//:argocd -- version
# --client`. It follows argocd.version() (the `@argocd` hub). As a runfile:
# `$(rlocationpath @rules_argocd//:argocd)`.
alias(
    name = "argocd",
    actual = "@argocd//:argocd",
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//private:argocd_health_check",
        "//private:argocd_install",
        "//private:providers",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = ["//private:repositories"],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
    deps = ["//private:repositories"],
)
