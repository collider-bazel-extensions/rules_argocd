"""rules_argocd — hermetic Argo CD install + readiness for Bazel tests."""

module(
    name = "rules_argocd",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.7.0")

argocd = use_extension("//:extensions.bzl", "argocd")

# Pinned Argo CD release. The extension fetches `manifests/install.yaml`
# from the matching upstream tag and sha256-verifies it; consumers don't
# need helm — kubectl-only at runtime. Add more versions by tagging them
# in private/versions.bzl and calling argocd.version() again.
argocd.version(
    name = "argocd",
    version = "3.3.8",
)

use_repo(argocd, "argocd")

# Dev only: the smoke test's install.yaml (redis imagePullPolicy
# IfNotPresent; see tests/BUILD.bazel). Registered first so it wins.
register_toolchains("//tests:smoke_toolchain", dev_dependency = True)

register_toolchains("@argocd//:all")

# ---- dev-only: rules_kind + rules_itest for the smoke test ------------------
# Consumers do NOT inherit these. The in-tree smoke test composes a kind
# cluster, Argo CD via this rule set, and an Application reconciliation
# assertion against argoproj/argocd-example-apps.
bazel_dep(name = "rules_itest", version = "0.0.52", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "rules_kind", version = "0.2.1", dev_dependency = True)
git_override(
    module_name = "rules_kind",
    remote = "https://github.com/collider-bazel-extensions/rules_kind",
    commit = "b3f1b1d4215b3793ee2d5673f552141c44af126d",  # v0.2.1 — reaper survives the end of the test; podman uses the real image store
)

# ---- dev-only: redis image preloaded into the smoke cluster -----------------
# Anonymous pulls of Argo CD's redis from public.ecr.aws hit ECR's rate
# limit on GitHub runners ("429 Data limit exceeded"), so the smoke test
# loads the image into the kind nodes at boot (tests/BUILD.bazel). Bazel
# fetches it once by digest; the repository cache keeps it.
# Digest = the multi-arch index of redis:8.2.3-alpine, the tag install.yaml
# uses (//tests:smoke_install_yaml fails when an Argo CD bump changes it).
# Fetched from mirror.gcr.io (Google's Docker Hub cache, same Docker Official
# Image, same digest) because ECR Public also returns 429 to Bazel's fetch on
# GitHub runners. The digest pins the content whichever registry serves it;
# tests/BUILD.bazel tags it with the public.ecr.aws name install.yaml uses.
bazel_dep(name = "rules_oci", version = "2.3.0", dev_dependency = True)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci", dev_dependency = True)
oci.pull(
    name = "redis",
    digest = "sha256:08ad0b1d280850169a790dba1393ff7a90aef951fc19632cf4d3ce4f78e679ba",
    image = "mirror.gcr.io/library/redis",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
use_repo(oci, "redis_linux_amd64", "redis_linux_arm64")
