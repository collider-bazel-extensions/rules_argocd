"""Bzlmod extension. Same shape as rules_certmanager: one `version` tag class."""

load("//private:repositories.bzl", "argocd_version_repository")

_version_tag = tag_class(attrs = {
    "name": attr.string(default = "argocd"),
    "version": attr.string(mandatory = True),
})

def _impl(mctx):
    # Only honor `version` tags from the root module. Without this guard,
    # both rules_argocd (when consumed as a dep) and the consumer would each
    # emit a `@argocd` repo with the same `name`, and Bazel collides them:
    # "A repo named argocd is already generated by this module extension".
    # The library's own MODULE.bazel still needs `argocd.version()` so its
    # in-tree smoke test can build, but that only fires when rules_argocd
    # itself is the root.
    for mod in mctx.modules:
        if not mod.is_root:
            continue
        for tag in mod.tags.version:
            argocd_version_repository(
                name = tag.name,
                version = tag.version,
            )

argocd = module_extension(
    implementation = _impl,
    tag_classes = {"version": _version_tag},
)
